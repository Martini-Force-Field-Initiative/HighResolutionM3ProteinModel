 N  CA  C  +N  9   54.358  1.035  3  {"edge":false, "group": "PSI dihedrals (Default)", "version":1}
 N  CA  C  +N  9  -21.081  1.437  4  {"edge":false, "group": "PSI dihedrals (Default)", "version":2}
 N  CA  C  +N  9  -58.950  0.907  5  {"edge":false, "group": "PSI dihedrals (Default)", "version":3}
[ edges ]
 N   CA
 CA  C
 C   +N
[ patterns ]
 N  CA  C  {"resname": "GLY"} +N

