[ citations ]
M3HighResBeta
Martini3

[ macros ]
;; bead types & properties
prot_default_bb_type  SP1
prot_PRO_bb_type      SP1r
prot_ALA_bb_type      SP2
prot_GLY_bb_type      SP3
prot_default_N_type   U
prot_default_O_type   U
prot_PRO_N_type       Up
prot_PRO_O_type       U
pos                   0.1
neg                   -0.1
ca_mass               46
o_mass                32

;; bonded terms
cao                   0.241
stiff_fc              100000
n_ca_c_ref            110.5
n_ca_c_fc             400


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  ALANINE (ALA)                                     ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[ moleculetype ]
;molname  nrexcl
 ALA           1

[ atoms ]
;id  type                  resnr  residu  atom  cgnr  charge  mass
  1  $prot_default_N_type      1  ALA     N        1  $pos    0
  2  U                         1  ALA     CA       2  0       $ca_mass
  3  $prot_ALA_bb_type         1  ALA     C        3  0       0
  4  $prot_default_O_type      1  ALA     O        4  $neg    $o_mass
  5  TC2                       1  ALA     SC1      5  0

[ edges ]
 N   CA
 CA  C
 CA  O
 C   O

[ bonds ]
 CA  SC1  1  0.165  10000  {"group": "ALA"}

[ constraints ]
 CA  O  1  $cao  {"group": "CA  — O "}

[ angles ]
;i    j   k  funct  ref.angle    force_k
 N    CA  C     10  $n_ca_c_ref  $n_ca_c_fc  {"group": "N  — CA  — C ",  "edge":false }
 SC1  CA  N     10  110.0        250         {"group": "ALA",  "edge":false}
 SC1  CA  O     10  105.0        45          {"group": "ALA",  "edge":false}

[ dihedrals ]
 SC1  CA  N  C  2  -124.0  250     {"group": "ALA",  "edge":false}
 SC1  CA  O  C  9    10.0    4  2  {"group": "ALA",  "edge":false}
 SC1  CA  O  C  9    10.0    5  1  {"group": "ALA",  "edge":false}
 SC1  CA  O  C  9   100.0    1  1  {"group": "ALA",  "edge":false}

[ exclusions ]
 O  N  C  SC1
 N  C  SC1
 C  SC1


