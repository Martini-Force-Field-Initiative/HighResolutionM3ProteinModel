[ modification ]
[ from ]
amber
[ to ]
M3HighResBeta
[ from blocks ]
C-ter
[ to blocks ]
C-ter

[ from nodes ]
N
HN
[ from edges ]
HN N
N CA

[ mapping ]
CA CA
C  C
O  O
OXT O


[modification]
[ from ]
amber
[ to ]
M3HighResBeta
[ from blocks ]
N-ter
[ to blocks ]
N-ter

[ from nodes ]
C
O
[ from edges ]
C O
CA C

[ mapping ]
HN2 N
HN3 N
N   N
CA  CA
C   C
