[ citations ]
M3HighResBeta
Martini3

[ macros ]
protein_resnames        "GLY|ALA|CYS|VAL|LEU|ILE|MET|PRO|HYP|ASN|GLN|ASP|ASPP|ASH|GLU|GLUP|GLH|THR|SER|LYS|LSN|LYN|ARG|ARG0|HIS|HISH|HSE|HSD|HSP|PHE|TYR|TRP|DGLY|DALA|DCYS|DVAL|DLEU|DILE|DMET|DPRO|DHYP|DASN|DGLN|DASP|DAPP|DGLU|DGLP|DTHR|DSER|DLYS|DLSN|DARG|DARG0|DHIS|DHISH|DHSE|DHSD|DHSP|DPHE|DTYR|DTRP"
l_amino_resnames        "GLY|ALA|CYS|VAL|LEU|ILE|MET|PRO|HYP|ASN|GLN|ASP|ASPP|ASH|GLU|GLUP|GLH|THR|SER|LYS|LSN|LYN|ARG|ARG0|HIS|HISH|HSE|HSD|HSP|PHE|TYR|TRP"
d_amino_resnames        "DGLY|DALA|DCYS|DVAL|DLEU|DILE|DMET|DPRO|DHYP|DASN|DGLN|DASP|DAPP|DGLU|DGLP|DTHR|DSER|DLYS|DLSN|DARG|DARG0|DHIS|DHISH|DHSE|DHSD|DHSP|DPHE|DTYR|DTRP"

protein_resnames_pro    "PRO|HYP"
d_protein_resnames_pro  "DPRO|DHYP"


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  D-AMINO ACIDS: STANDARD PHI/PSI DIHEDRALS         ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; These dihedrals represent an unbiased mix of all secondary structures.
; They are applied by default but should only be used with tertiary structure
; biases such as OLIVES.
; Note: a D-amino acid preceding an L-PRO (and vice versa) may not be handled
; correctly yet.

;; General
[ link ]
resname $protein_resnames
[ dihedrals ]
 -C  N  CA  C  9  -63.864  6.059  1  {"edge":false, "group": "PHI dihedrals (Default)"}
 -C  N  CA  C  9    9.561  4.858  2  {"edge":false, "group": "PHI dihedrals (Default)", "version":1}
 -C  N  CA  C  9  -11.834  3.053  3  {"edge":false, "group": "PHI dihedrals (Default)", "version":2}
 -C  N  CA  C  9   13.965  2.339  4  {"edge":false, "group": "PHI dihedrals (Default)", "version":3}
[ edges ]
 -C  N
 N   CA
 CA  C
[ patterns ]
 -C  N  CA  C  {"resname": $d_amino_resnames}

[ link ]
resname $protein_resnames
[ dihedrals ]
 N  CA  C  +N  9    93.355  2.590  1  {"edge":false, "group": "PSI dihedrals (Default)"}
 N  CA  C  +N  9  -112.873  5.309  2  {"edge":false, "group": "PSI dihedrals (Default)", "version":1}
 N  CA  C  +N  9   -43.259  2.082  3  {"edge":false, "group": "PSI dihedrals (Default)", "version":2}
 N  CA  C  +N  9    10.677  1.806  4  {"edge":false, "group": "PSI dihedrals (Default)", "version":3}
[ edges ]
 N   CA
 CA  C
 C   +N
[ patterns ]
 N  CA  C  {"resname": $d_amino_resnames} +N

;; PRO
[ link ]
resname $protein_resnames
[ dihedrals ]
 -C  N  CA  C  9  -112.042  8.593  1  {"edge":false, "group": "PHI dihedrals (Default)"}
 -C  N  CA  C  9   -32.854  4.199  2  {"edge":false, "group": "PHI dihedrals (Default)", "version":1}
 -C  N  CA  C  9    14.869  2.965  3  {"edge":false, "group": "PHI dihedrals (Default)", "version":2}
 -C  N  CA  C  9   106.200  1.561  5  {"edge":false, "group": "PHI dihedrals (Default)", "version":3}
[ edges ]
 -C  N
 N   CA
 CA  C
[ patterns ]
 -C  N  CA  C  {"resname": $d_protein_resnames_pro}

[ link ]
resname $protein_resnames
[ dihedrals ]
 N  CA  C  +N  9    98.457  2.652  1  {"edge":false, "group": "PSI dihedrals (Default)"}
 N  CA  C  +N  9  -116.058  5.915  2  {"edge":false, "group": "PSI dihedrals (Default)", "version":1}
 N  CA  C  +N  9   -38.305  1.107  3  {"edge":false, "group": "PSI dihedrals (Default)", "version":2}
 N  CA  C  +N  9   -39.267  2.053  4  {"edge":false, "group": "PSI dihedrals (Default)", "version":3}
[ edges ]
 N   CA
 CA  C
 C   +N
[ patterns ]
 N  CA  C  {"resname": $d_protein_resnames_pro} +N

;; Pre-PRO
[ link ]
resname $protein_resnames
[ dihedrals ]
 -C  N  CA  C  9  -84.105  7.457  1  {"edge":false, "group": "PHI dihedrals (Default)"}
 -C  N  CA  C  9   40.667  4.070  2  {"edge":false, "group": "PHI dihedrals (Default)", "version":1}
 -C  N  CA  C  9   -6.232  3.323  3  {"edge":false, "group": "PHI dihedrals (Default)", "version":2}
 -C  N  CA  C  9    2.519  2.387  4  {"edge":false, "group": "PHI dihedrals (Default)", "version":3}
[ edges ]
 -C  N
 N   CA
 CA  C
 C   +N
[ patterns ]
 -C  N  CA  C  {"resname": $d_amino_resnames} +N {"resname": $d_protein_resnames_pro}

[ link ]
resname $protein_resnames
[ dihedrals ]
 N  CA  C  +N  9   74.377  4.990  1  {"edge":false, "group": "PSI dihedrals (Default)"}
 N  CA  C  +N  9  -84.577  7.111  2  {"edge":false, "group": "PSI dihedrals (Default)", "version":1}
 N  CA  C  +N  9  -22.786  4.408  3  {"edge":false, "group": "PSI dihedrals (Default)", "version":2}
 N  CA  C  +N  9  -12.930  1.234  4  {"edge":false, "group": "PSI dihedrals (Default)", "version":3}
[ edges ]
 N   CA
 CA  C
 C   +N
[ patterns ]
 N  CA  C  {"resname": $d_amino_resnames} +N {"resname": $d_protein_resnames_pro}


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;  SECONDARY STRUCTURE SPECIFIC PHI/PSI DIHEDRALS    ;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; These dihedrals are biased towards specific secondary structures.
; They are applied when calling -dssp or -ss. They are currently the standard
; when not using tertiary bias, when using ENs and Go models.

;;;; COIL ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[ link ]
resname $protein_resnames
[ dihedrals ]
 -C  N  CA  C  9  -89.389  6.799  1  {"edge":false, "group": "PHI dihedrals (Coil)"}
 -C  N  CA  C  9   38.946  5.020  2  {"edge":false, "group": "PHI dihedrals (Coil)", "version":1}
 -C  N  CA  C  9  -17.494  4.148  3  {"edge":false, "group": "PHI dihedrals (Coil)", "version":2}
 -C  N  CA  C  9  -10.268  1.055  4  {"edge":false, "group": "PHI dihedrals (Coil)", "version":3}
[ edges ]
 -C  N
 N   CA
 CA  C
[ patterns ]
 -C  N  CA  C  {"cgsecstruct": "C","resname": $d_amino_resnames}

[ link ]
resname $protein_resnames
[ dihedrals ]
 N  CA  C  +N  9    98.395  4.434  1  {"edge":false, "group": "PSI dihedrals (Coil)"}
 N  CA  C  +N  9  -123.595  4.764  2  {"edge":false, "group": "PSI dihedrals (Coil)", "version":1}
 N  CA  C  +N  9    -9.335  0.764  4  {"edge":false, "group": "PSI dihedrals (Coil)", "version":2}
 N  CA  C  +N  9    67.210  0.430  5  {"edge":false, "group": "PSI dihedrals (Coil)", "version":3}
[ edges ]
 N   CA
 CA  C
 C   +N
[ patterns ]
 N  CA  C  {"cgsecstruct": "C","resname": $d_amino_resnames} +N

;; Coil: PRO
[ link ]
resname $protein_resnames
